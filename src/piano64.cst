//File Title: Physical Constraints file
//Device: GW5AST-138   Device Version: C
//Part Number: GW5AST-LV138PG484AC1/I0
//Project: piano_twinkle_dac

//=================== 系统时钟 (V22, 50MHz 晶振) ===================
IO_LOC  "CLOCK_50" V22;
IO_PORT "CLOCK_50" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=OFF BANK_VCCIO=3.3;

//=================== 复位 (AB13) =================================
IO_LOC  "RESET_n"  AB13;
IO_PORT "RESET_n"  IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;

//=================== I2S → PAC5102A ==============================
//  DAC 侧：  LCK → P16     DIN → R17     BCK → V17
//
//  ★★ 三个脚的真实对应关系（从原理图 PDF 的网络名解析出来，
//     格式是 BANK4_<球号>_<内部名>）：
//        J14 脚 6  SDRAM1_D5   → P16  IOB144A   = LCK
//        J14 脚 8  SDRAM1_D7   → R18  IOB138A   = DIN
//        J14 脚 10 SDRAM1_D14  → V17  IOB106A   = BCK
//        J14 脚 4  SDRAM1_D3   → T21  IOB97A    = （已被 WS2812 灯带占用）
//        J14 脚 11 = 5V_Peripheral，脚 12 = GND
//
//  ★ 注意：SDRAM1_Dn 这批脚和 PMOD0/PMOD1 是【同一批球复用】的
//     （原理图标注 {SDRAM1|DVP_CAM|PMOD}）。所以丝印上的 T21/P16/R18/V17
//     才是真实 FPGA 球号，SDRAM1_Dn 只是网络名。
//     ★ 曾经把 R18 看成 R10：R10 在 PBGA484A 上是 VSS（地球），
//       不是 I/O，接上去等于把信号短到地。
//
//  ★ P16 = IOB144A(CFG=D17)、R17 = IOB144B(CFG=D16)、V17 = IOB106A(CFG=CSI_B)
//    这三个都挂在配置总线上 → build.tcl 里必须开：
//        set_option -use_cpu_as_gpio  1
//        set_option -use_sspi_as_gpio 1
//
IO_LOC  "AUD_LRCK" P16;
IO_PORT "AUD_LRCK" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

IO_LOC  "AUD_DIN"  R18;
IO_PORT "AUD_DIN"  IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

IO_LOC  "AUD_BCK"  V17;
IO_PORT "AUD_BCK"  IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

//=================== 6 个按键开关 (J14 脚 21~26) ===================
//  从左到右：26 → 25 → 24 → 23 → 22 → 21 → 映射到 KEY[0]..KEY[5]
//  ★ 按键【默认悬空，按下接地】→ 片内上拉(PULL_MODE=UP)，
//    悬空读到 1、按下读到 0。key_scan 内部会取反成"按下=1"。
//  这些球和 PMOD1 是同一批复用（原理图 {SDRAM1|DVP_CAM|PMOD}）：
//    J14脚26 AA20=PMOD1_IO4   J14脚25 AA21=PMOD1_IO5   J14脚24 AB21=PMOD1_IO2
//    J14脚23 AB22=PMOD1_IO3   J14脚22 Y21 =PMOD1_IO0   J14脚21 Y22 =PMOD1_IO1
IO_LOC  "KEY[0]" AA20;   // J14 脚 26  最左 → do  (C4)
IO_PORT "KEY[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC  "KEY[1]" AA21;   // J14 脚 25       → re  (D4)
IO_PORT "KEY[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC  "KEY[2]" AB21;   // J14 脚 24       → mi  (E4)
IO_PORT "KEY[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC  "KEY[3]" AB22;   // J14 脚 23       → fa  (F4)
IO_PORT "KEY[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC  "KEY[4]" Y21;    // J14 脚 22       → sol (G4)
IO_PORT "KEY[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC  "KEY[5]" Y22;    // J14 脚 21  最右 → la  (A4)
IO_PORT "KEY[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;

//=================== WS2812 灯带数据 (J14 脚 4 = T21) =============
//  ★ T21 = IOB97A，专用功能 D04(CPU) → build.tcl 里必须开 -use_cpu_as_gpio
//  这和 PMOD0_IO2 是同一个球。

//=================== 模式切换键 (J14 脚 40 = P14) =================
//  每按一次切换一个模式：1 自动 → 2 自由 → 3 指导 → 1
//  同时点亮【第 2 颗】灯作模式指示：红=模式1  绿=模式2  蓝=模式3
//  ★ 默认悬空、按下接地 → PULL_MODE=UP
IO_LOC  "KEY[6]" P14;   // 模式键（1=按键 → 2=指导小星星 → 3=指导欢乐颂）
IO_PORT "KEY[6]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;

// 模式键（1=按键 → 2=指导小星星 → 3=指导欢乐颂 → 1）

//=================== WS2812 灯带 ===================
// ★ 必须用 J16！板上这颗脚有 3.3V→5V 电平转换（Q16）+ 49.9Ω 串阻（R121），
//   再接到 J24 aRGB 灯带接口和板载 WS2812B-2020(U15)。
//   之前接的 T21（J14 脚 4）是裸 PMOD 引脚，只有 3.3V、无串阻，
//   而灯带 5V 供电时 VIH=0.7×5=3.5V → 3.3V 不达标 → 数据位随机判错。
IO_LOC  "DOUT" T21;
IO_PORT "DOUT" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
