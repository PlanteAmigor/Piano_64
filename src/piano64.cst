//File Title: Physical Constraints file
//Device: GW5AST-138   Device Version: C
//Part Number: GW5AST-LV138PG484AC1/I0
//Project: piano_twinkle_dac

//=================== 系统时钟 (V22, 50MHz 晶振) ===================
IO_LOC  "CLOCK_50" V22;
IO_PORT "CLOCK_50" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=OFF BANK_VCCIO=3.3;

//=================== 复位 (AB13) =================================
IO_LOC  "RESET_n"  AB13;
IO_PORT "RESET_n"  IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;

//=================== 测试模式键 KEY.0 (AA13) ======================
//  板载 3 个用户键（原理图 EX_KEY.0/1/2，官方例程叫 KEY.0/1/2）：
//      KEY.0 = AA13  ← 本用（测试模式）
//      KEY.1 = AB13  ← 已用作 RESET_n
//      KEY.2 = Y12   ← 空闲
//  原理图原文："USER_BUTTONn, requires enable internal pull-up"
//  → 必须 PULL_MODE=UP；悬空=1，按下=0（低有效）
IO_LOC  "KEY0"  AA13;
IO_PORT "KEY0"  IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;

//=================== I2S → PAC5102A ==============================
//  DAC 侧：  LCK → P16     DIN → R17     BCK → V17
//
//  ★★ 三个脚的真实对应关系（从原理图 PDF 的网络名解析出来，
//     格式是 BANK4_<球号>_<内部名>）：
//        J14 脚 6  SDRAM1_D5   → P16  IOB144A   = LCK
//        J14 脚 8  SDRAM1_D7   → R18  IOB138A   = DIN
//        J14 脚 10 SDRAM1_D14  → V17  IOB106A   = BCK
//        J14 脚 4  SDRAM1_D3   → T21  IOB97A    = （已被 WS2812 灯带占用）
//        J14 脚 11 = 5V_Peripheral，脚 12 = GND
//
//  ★ 注意：SDRAM1_Dn 这批脚和 PMOD0/PMOD1 是【同一批球复用】的
//     （原理图标注 {SDRAM1|DVP_CAM|PMOD}）。所以丝印上的 T21/P16/R18/V17
//     才是真实 FPGA 球号，SDRAM1_Dn 只是网络名。
//     ★ 曾经把 R18 看成 R10：R10 在 PBGA484A 上是 VSS（地球），
//       不是 I/O，接上去等于把信号短到地。
//
//  ★ P16 = IOB144A(CFG=D17)、R17 = IOB144B(CFG=D16)、V17 = IOB106A(CFG=CSI_B)
//    这三个都挂在配置总线上 → build.tcl 里必须开：
//        set_option -use_cpu_as_gpio  1
//        set_option -use_sspi_as_gpio 1
//
IO_LOC  "AUD_LRCK" C13;
IO_PORT "AUD_LRCK" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

IO_LOC  "AUD_DIN"  A13;
IO_PORT "AUD_DIN"  IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

IO_LOC  "AUD_BCK"  B15;
IO_PORT "AUD_BCK"  IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

//==========================================================================
//  ★★★ 18 键力度键盘（J13，2026-10-30 定案）★★★
//--------------------------------------------------------------------------
//  键盘板 20 个按键 = 2 排 × 9 + 上方 2 个独立键
//
//  两排"一前一后"配对成 9 组：
//        [前排] 先闭合 ──Δt──> [后排] 后闭合
//        Δt 越小 = 力度越大（模拟真钢琴双触点测速）
//
//        组 0..7  → 8 个音键 → 8 声部（八路必定不同音）
//        组 8     → 切换音高（该组 2 个键都是功能键）
//        上方 2 键 → 备用功能键（模式/音色切换）
//
//  端口命名：
//        KEY_R1 [0..8]   第 1 排（PCB 图上排）
//        KEY_R2 [0..8]   第 2 排（PCB 图下排）
//        KEY_AUX[0..1]   上方两个独立键
//
//  ★★ 哪一排是"先按下"的那一排，必须上电实测确认 ★★
//      RTL 里用参数 FRONT_ROW 切换（0=R1 先，1=R2 先），
//      不需要改这里。测法：慢慢按一个键，看哪一个先闭合。
//
//  ★ 每键必须独立球号，禁止矩阵扫描 —— 矩阵会丢失单键前后触点的
//    微秒级时间差，力度就测不出来了
//  ★ 全部 PULL_MODE=UP（默认悬空、按下接地），采样走高速路径
//  ★ 已确认这 20 个球与 DDR3（Y1-Y9/AA1-AA8/AB1-AB8）无冲突
//--------------------------------------------------------------------------
//  配对表（从左到右）：
//    组  第1排 位号/球号/J13脚      第2排 位号/球号/J13脚
//     0   U24 D14  26              U30 F16  32
//     1   U23 D15  25              U29 E17  31
//     2   U22 A18  24              U28 F13  30
//     3   U21 A19  23              U27 F14  29
//     4   U20 D17  22              U26 E16  28
//     5   U19 C17  21              U25 D16  27
//     6   U33 C20  35              U36 E19  38
//     7   U32 F15  34              U35 D19  37
//     8   U31 F19  33  ← 切音高   U34 D20  36
//==========================================================================

//--------------------- 第 1 排 (9 个) -------------------------------------
IO_LOC  "KEY_R1[0]" D14;   // U24  J13-26
IO_PORT "KEY_R1[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC  "KEY_R1[1]" D15;   // U23  J13-25
IO_PORT "KEY_R1[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC  "KEY_R1[2]" A18;   // U22  J13-24
IO_PORT "KEY_R1[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC  "KEY_R1[3]" A19;   // U21  J13-23
IO_PORT "KEY_R1[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC  "KEY_R1[4]" D17;   // U20  J13-22
IO_PORT "KEY_R1[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC  "KEY_R1[5]" C17;   // U19  J13-21
IO_PORT "KEY_R1[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC  "KEY_R1[6]" C20;   // U33  J13-35
IO_PORT "KEY_R1[6]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC  "KEY_R1[7]" F15;   // U32  J13-34
IO_PORT "KEY_R1[7]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC  "KEY_R1[8]" F19;   // U31  J13-33   切音高
IO_PORT "KEY_R1[8]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;

//--------------------- 第 2 排 (9 个) -------------------------------------
IO_LOC  "KEY_R2[0]" F16;   // U30  J13-32
IO_PORT "KEY_R2[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC  "KEY_R2[1]" E17;   // U29  J13-31
IO_PORT "KEY_R2[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC  "KEY_R2[2]" F13;   // U28  J13-30   ★ 路径经 R68 (0Ω)
IO_PORT "KEY_R2[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC  "KEY_R2[3]" F14;   // U27  J13-29   ★ 路径经 R70 (0Ω)
IO_PORT "KEY_R2[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC  "KEY_R2[4]" E16;   // U26  J13-28
IO_PORT "KEY_R2[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC  "KEY_R2[5]" D16;   // U25  J13-27
IO_PORT "KEY_R2[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC  "KEY_R2[6]" E19;   // U36  J13-38
IO_PORT "KEY_R2[6]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC  "KEY_R2[7]" D19;   // U35  J13-37
IO_PORT "KEY_R2[7]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC  "KEY_R2[8]" D20;   // U34  J13-36   切音高
IO_PORT "KEY_R2[8]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;

//--------------------- 上方两个独立键 -------------------------------------
IO_LOC  "KEY_AUX[0]" C18;  // U38  J13-40
IO_PORT "KEY_AUX[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC  "KEY_AUX[1]" C19;  // U37  J13-39
IO_PORT "KEY_AUX[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;

//==========================================================================
//  ↓↓↓ 以下为旧 PMOD1 按键 + P14 模式键（新键盘板接入后应删除）↓↓↓
//  保留仅为让当前 RTL 仍能综合；改 add_top 端口时一并去掉。
//==========================================================================

//==========================================================================
//  旧 PMOD1 六个按键（J14 脚 21~26）与 P14 模式键：已删除
//    AA20 AA21 AB21 AB22 Y21 Y22 P14 现全部空闲，可作他用
//==========================================================================

//=================== WS2812 灯带 ===================
// ★ 必须用 J16！板上这颗脚有 3.3V→5V 电平转换（Q16）+ 49.9Ω 串阻（R121），
//   再接到 J24 aRGB 灯带接口和板载 WS2812B-2020(U15)。
//   之前接的 T21（J14 脚 4）是裸 PMOD 引脚，只有 3.3V、无串阻，
//   而灯带 5V 供电时 VIH=0.7×5=3.5V → 3.3V 不达标 → 数据位随机判错。
IO_LOC  "DOUT" C14;
IO_PORT "DOUT" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

//==========================================================================
//  TF 卡（1-bit SD 模式）+ 调试串口  （2026-10-31 加入，SD→DDR 加载用）
//--------------------------------------------------------------------------
//  引脚全部取自 sd_bringup（已上板验证 SD→BSRAM md5 全对）。
//  ★ 都在 BANK5（IOB），VCCIO=3.3，与 DDR3 的 BANK6/BANK7（1.5V）无冲突。
//  ★ SD_DAT1~3（W15 等）在 1-bit 模式下不驱动，不约束即可
//    （综合器 Unused_Pin=As_input_tri_stated_with_pull_up 正好符合 SD 要求）。
//==========================================================================
IO_LOC  "SD_CLK"  V15;
IO_PORT "SD_CLK"  IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

IO_LOC  "SD_CMD"  Y16;
IO_PORT "SD_CMD"  IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

IO_LOC  "SD_DAT0" AA15;
IO_PORT "SD_DAT0" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

//  串口 TX → 板载调试器 → /dev/ttyUSB2（sd_bringup 已验证）
IO_LOC  "UART_TX" U15;
IO_PORT "UART_TX" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

//==========================================================================
//  ★★★ DDR3 1 GiB 物理引脚（原 src/ddr/ddr3_1v4_hs.cst）★★★
//--------------------------------------------------------------------------
//  【必须合并到本文件】—— gw_sh 只认 `add_file` 列表里的【最后一个 .cst】
//  作为物理约束文件，前面的会被静默忽略（日志里只会出现一行
//  "Reading constraint file: .../ddr3_1v4_hs.cst"）。
//  后果：本文件的 CLOCK_50 / RESET_n / I2S / 键盘 / 灯带 全部失约束，
//        PnR 自动乱放（实测 CLOCK_50 被丢到 Y11 → 时钟不接晶振 → 全设计死掉：
//        没声、灯带不亮）。
//  所以 src/ddr/ddr3_1v4_hs.cst 仅作备份留档，build.tcl 里【不再 add_file】。
//==========================================================================
