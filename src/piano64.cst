// ── DDR IP 内部物理位置（DLL 与分频器必须钉死）──
INS_LOC "u_ddr/u_ddr3/gw3_top/u_ddr_phy_top/u_dll" DDRDLLM_BL;
INS_LOC "u_ddr/u_ddr3/gw3_top/u_ddr_phy_top/fclkdiv" LEFTSIDE[4];
// ★ 供应商 .cst 里第三条：memory_clk 的 PLL 必须放在 DDR 旁边的 PLL_L[0]。
//   不加这条 → init_calib_complete 永远为 0
//   （实测横幅 P64 C=0 L=1 P=1 R=1：PLL 锁了、复位放了，就是校准不完成）。
//
//   ★★ 对象名为什么是 "u_ddr/PLL_inst" 而不是完整的 4 层路径 ★★
//  源码层次是：ddr_wrap u_ddr → Gowin_PLL_DDR u_pll → Gowin_PLL_MOD_DDR u_pll
//              → PLL 原语 PLL_inst
//   但 Gowin 综合会把自己的 RTL 打平（加密的 DDR IP 内部层次才保留），
//   所以 PnR 里能看到的对象是 u_ddr/PLL_inst。
//   实测 u_ddr/u_pll/u_pll/PLL_inst 和 u_ddr/u_pll/PLL_inst 都报
//   ERROR (CT1135) Can't find object —— 只有这个能过。
INS_LOC "u_ddr/u_pll/u_pll_0/PLL_inst" PLL_L[0];

//==========================================================================
//  六路光敏前端（F407 那一套）：红外发射 + AD7606 双串行
//  详细说明见 piano64_hdmi.cst 同名段（两份必须保持一致）
//==========================================================================
IO_LOC  "IR_EMIT[0]" P16;
